<% @deck.boards.each do |board| %>
  <%= link_to edit_user_deck_board_path(@user, @deck, board), class: "btn btn-primary my-1" do %>
    <i class="bi bi-pencil-fill me-2"></i><%= board.board_type.name %>
  <% end %> 
<% end %>

<%# link_to "+ Add New Board", new_user_deck_board_path(@user, @deck), class: "btn btn-outline-primary my-1" %>
<button class="btn btn-outline-primary" data-action="click->editing-deck#openBoardTypeTable">+ Add New Board</button>
<div data-editing-deck-target="add-board-type-table" class="board-type-table">
  <% @board_types_not_yet_added.each do |type| %>
    <%= link_to type, user_deck_boards_path(@user, @deck, board_type: type), data: { turbo_method: :post }, class: "btn btn-outline-primary m-2" %>
  <% end %>
</div>