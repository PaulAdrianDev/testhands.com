<div class="mt-4 py-3 archetypes-table" id="decks-table" data-deck-search-target="decks_table">
  <% @archetypes.each do |archetype| %>
    <button class="btn btn-outline-primary my-1 mx-1 rounded-5 px-4"
    value="<%= archetype.id %>" 
    data-action="deck-search#open"
    <%= "disabled" unless @playable_archetype_ids.include?(archetype.id) %>>
      <%= archetype.name %>
    </button>
  <% end %>
</div>